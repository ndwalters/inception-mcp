{
  "name": "inception-mcp",
  "version": "0.1.3",
  "description": "MCP server for the Inner Range Inception REST API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepare": "tsc",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs",
    "test": "npm run build && node scripts/smoke.mjs && node scripts/smoke-stdio.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "inception-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "author": "ndwalters (https://github.com/ndwalters)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndwalters/inception-mcp.git"
  },
  "homepage": "https://github.com/ndwalters/inception-mcp",
  "bugs": {
    "url": "https://github.com/ndwalters/inception-mcp/issues"
  }
