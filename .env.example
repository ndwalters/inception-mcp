# Inception controller (no trailing /api/v1)
INCEPTION_URL=http://192.168.1.50
# Inception > Users > (API user) > Credentials > User API Token
INCEPTION_API_TOKEN=

# HTTP mode only. Secret MCP clients send as "Authorization: Bearer <token>"  (openssl rand -hex 32)
MCP_AUTH_TOKEN=

# HTTP mode only: interface to listen on
HOST=127.0.0.1
PORT=3000

# Optional: restrict who may call the server (default: loopback + RFC1918 + IPv6 ULA/link-local)
# MCP_ALLOWED_CIDRS=192.168.1.0/24,127.0.0.1/32

